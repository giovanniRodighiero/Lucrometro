<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground. 108dp canvas; the artwork group is scaled 0.92 so it stays inside the 66dp safe zone (radius 33 from 54,54). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Whole artwork scaled to 92% about the centre: keeps it inside the 66dp safe zone (radius 33). -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.92"
        android:scaleY="0.92">

        <!-- Area chart behind the note -->
        <path
            android:fillColor="@color/ic_launcher_gain"
            android:fillAlpha="0.3"
            android:pathData="M29,76 L29,58 L38,49 L46,54 L56,40 L65,44 L76,31 L76,76 Z" />
        <path
            android:pathData="M29,58 L38,49 L46,54 L56,40 L65,44 L76,31"
            android:strokeColor="@color/ic_launcher_gain"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:fillColor="@color/ic_launcher_gain"
            android:pathData="M72.2,31 a3.8,3.8 0 1,0 7.6,0 a3.8,3.8 0 1,0 -7.6,0 Z" />

        <!-- Banknote, tilted 5 degrees -->
        <group
            android:pivotX="54"
            android:pivotY="66"
            android:rotation="-5">
            <path
                android:fillColor="@color/ic_launcher_gain_container"
                android:pathData="M38,52 H70 A5,5 0 0 1 75,57 V75 A5,5 0 0 1 70,80 H38 A5,5 0 0 1 33,75 V57 A5,5 0 0 1 38,52 Z"
                android:strokeColor="@color/ic_launcher_gain"
                android:strokeWidth="2.5" />
            <path
                android:pathData="M39.5,56 H68.5 A2.5,2.5 0 0 1 71,58.5 V73.5 A2.5,2.5 0 0 1 68.5,76 H39.5 A2.5,2.5 0 0 1 37,73.5 V58.5 A2.5,2.5 0 0 1 39.5,56 Z"
                android:strokeAlpha="0.5"
                android:strokeColor="@color/ic_launcher_gain"
                android:strokeWidth="1" />

            <!-- Medallion with the smile -->
            <path
                android:fillColor="@color/ic_launcher_surface"
                android:pathData="M45,66 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 Z"
                android:strokeColor="@color/ic_launcher_gain"
                android:strokeWidth="1.8" />
            <path
                android:fillColor="@color/ic_launcher_gain"
                android:pathData="M49.6,64.5 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" />
            <path
                android:fillColor="@color/ic_launcher_gain"
                android:pathData="M55.6,64.5 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" />
            <path
                android:pathData="M50.5,68.5 Q54,72 57.5,68.5"
                android:strokeColor="@color/ic_launcher_gain"
                android:strokeWidth="1.6"
                android:strokeLineCap="round" />

            <!-- Euro marks on both sides of the medallion -->
            <path
                android:pathData="M42.8,64.2 A2.8,2.8 0 1 0 42.8,67.8 M38.4,65.2 H42.2 M38.4,66.8 H42.2"
                android:strokeColor="@color/ic_launcher_gain"
                android:strokeWidth="1.3"
                android:strokeLineCap="round" />
            <path
                android:pathData="M68.8,64.2 A2.8,2.8 0 1 0 68.8,67.8 M64.4,65.2 H68.2 M64.4,66.8 H68.2"
                android:strokeColor="@color/ic_launcher_gain"
                android:strokeWidth="1.3"
                android:strokeLineCap="round" />
        </group>
    </group>
</vector>
