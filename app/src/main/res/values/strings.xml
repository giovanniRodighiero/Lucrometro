<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Lucrometro</string>

    <!-- Watchlist -->
    <string name="watchlist_empty_title">No tickers yet</string>
    <string name="watchlist_empty_body">Tap + to add an ETF or a stock by its ticker code.</string>
    <string name="watchlist_updated">Updated %1$s</string>
    <string name="quote_stale_since">Stale since %1$s</string>
    <string name="quote_fetch_failed">Couldn\'t fetch</string>
    <string name="quote_pending" translatable="false">—</string>
    <!-- Price and currency code, e.g. "14.86 EUR". -->
    <string name="quote_price">%1$s %2$s</string>
    <!-- Day change: %1$s is the unsigned value, e.g. "1.24". Some languages space the sign (French: "+%1$s %%"). -->
    <string name="change_up">+%1$s%%</string>
    <string name="change_down">-%1$s%%</string>
    <string name="change_flat">%1$s%%</string>

    <!-- Absolute and percent change in one pill, e.g. "+0.86 (+2.14%)". %1$s abs, %2$s percent, both unsigned. -->
    <string name="change_up_abs">+%1$s (+%2$s%%)</string>
    <string name="change_down_abs">-%1$s (-%2$s%%)</string>
    <string name="change_flat_abs">%1$s (%2$s%%)</string>

    <string name="ticker_removed">%1$s removed</string>
    <string name="undo_failed">Couldn\'t restore %1$s</string>
    <string name="undo">Undo</string>
    <!-- Accessibility action on a row (TalkBack), the alternative to swiping it away. -->
    <string name="remove_ticker">Remove</string>

    <!-- Details screen -->
    <!-- Accessibility label of the tap action on a watchlist row (TalkBack). -->
    <string name="open_details">Open details</string>
    <string name="back">Back</string>
    <!-- The quote's own time: "Today, 14:32" while it is from today. -->
    <string name="quote_stamp_today">Today, %1$s</string>
    <!-- Otherwise the session day and time, e.g. "Fri, Nov 14, 5:35 PM". %1$s is the date, %2$s the time. -->
    <string name="quote_stamp_day">%1$s, %2$s</string>

    <!-- Range bar cells: keep them short, the bar has equal cells. -->
    <string name="range_5d">5D</string>
    <string name="range_1m">1M</string>
    <string name="range_3m">3M</string>
    <string name="range_6m">6M</string>
    <string name="range_1y">1Y</string>
    <string name="range_5y">5Y</string>
    <string name="range_max">Max</string>
    <!-- Readout label above the chart: the selected range. -->
    <string name="readout_past_5d">Past 5 days</string>
    <string name="readout_past_1m">Past month</string>
    <string name="readout_past_3m">Past 3 months</string>
    <string name="readout_past_6m">Past 6 months</string>
    <string name="readout_past_1y">Past year</string>
    <string name="readout_past_5y">Past 5 years</string>
    <string name="readout_all_time">All time</string>
    <!-- Readout value: the price at the start of the range. -->
    <string name="readout_from">From %1$s</string>
    <!-- TalkBack text of the chart: ticker, range, first and last price, signed change in percent. -->
    <string name="chart_description">%1$s, %2$s: from %3$s to %4$s, %5$s</string>
    <string name="chart_failed_title">Couldn\'t fetch</string>
    <string name="chart_failed_body">The chart needs a connection. Check it and try again.</string>
    <string name="retry">Retry</string>

    <!-- Add ticker sheet -->
    <string name="add_ticker">Add ticker</string>
    <string name="add_ticker_body">Paste a ticker code, like ENI.MI or VWCE.MI. We check it before saving.</string>
    <string name="add_ticker_label">Ticker code</string>
    <string name="add_ticker_hint">Borsa Italiana codes end in .MI</string>
    <string name="add_ticker_error_empty">Enter a ticker code</string>
    <string name="add_ticker_error_format">Use letters, digits and . - ^ = only, like ENI.MI</string>
    <string name="add_ticker_error_duplicate">%1$s is already in your list</string>
    <string name="add_ticker_error_not_found">%1$s was not found. Check the code and the market suffix.</string>
    <string name="add_ticker_error_no_price">%1$s has no price right now, so it can\'t be added</string>
    <string name="add_ticker_error_check_failed">Couldn\'t check %1$s. Check your connection and try again.</string>
    <string name="add_ticker_error_save_failed">Couldn\'t save %1$s. Try again.</string>
    <string name="add">Add</string>
    <string name="cancel">Cancel</string>
</resources>
